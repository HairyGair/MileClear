# EAS Build ignore — based on .gitignore but keeps packages/shared/dist/

# Dependencies
node_modules/
.pnpm-store/

# Build output (except shared package)
.next/
.expo/
out/
*.tsbuildinfo
apps/api/dist/
apps/web/dist/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Prisma
prisma/*.db

# Mobile
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
android/
ios/
# Local Expo module native code must reach the build (1.4.0 Directions).
!apps/mobile/modules/nav-voice/ios/
!apps/mobile/modules/nav-voice/android/
# Car Bluetooth (which car a trip was in), both phones.
!apps/mobile/modules/car-audio/ios/
!apps/mobile/modules/car-audio/android/

# Expo
web-build/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
Thumbs.db

# Uploads
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# Testing
coverage/
